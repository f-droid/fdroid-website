"  └── repo\n"
"      └── <package-id>\n"
"          └── <locale>\n"
"              ├── featureGraphic.png\n"
"              ├── icon.png\n"
"              ├── tvBanner.png\n"
"              ├── phoneScreenshots\n"
"              │   └── *.png\n"
"              ├── sevenInchScreenshots\n"
"              │   └── *.png\n"
"              ├── tenInchScreenshots\n"
