#: _pages/contribute.md
#, no-wrap
msgid "**Help the Community** \n"
msgstr "**Segítsen a közösségnek** \n"

#. type: Plain text
#: _pages/contribute.md
#, no-wrap
msgid "**You can help build a welcoming, empowered community by:**\n"
msgstr "**Az alábbi módokon segíthet abban, hogy hívogató és erős közösséget építsünk:**\n"

#. type: Bullet: '* '
#: _pages/contribute.md
msgid "Answering questions from new users or developers in our [forum](https://forum.f-droid.org/) or [chat]({{ site.baseurl }}/about/#contact)"
msgstr "Válaszoljon az új felhasználók vagy fejlesztők kérdéseire a [fórumunkon](https://forum.f-droid.org/) vagy a [csevegőnkben]({{ site.baseurl }}/about/#contact)"

#. type: Bullet: '* '
#: _pages/contribute.md
msgid "Joining the conversation in our [various channels]({{ site.baseurl }}/about/#contact)"
