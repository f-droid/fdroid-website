#. type: Title ###
#: _pages/about.md
#, no-wrap
msgid "Consulting / Commercial Support"
msgstr "ייעוץ / תמיכה מסחריים"

#. type: Plain text
#: _pages/about.md
#, fuzzy
msgid "Using F-Droid in your organization and want to have an expert on board? We have a list of F-Droid contributors that offer consulting services. We can help you whitelabel F-Droid, integrate our tech stack into your project and create project specific features to suit your unique needs."
msgstr "משתמשים ב־F-Droid בארגון שלכם ורוצים להוסיף מומחה לצוות? יש לנו רשימה של תורמים ל־F-Droid שמציעים שירותי ייעוץ. אנחנו יכולים לעזור לכם להלביש מותג על F-Droid, לשלב את טכנולוגיית הסטאק שלנו בפרויקט שלכם וליצור תכונות מותאמות אישית לצרכים הייחודיים שלכם."

#. type: Plain text
#: _pages/about.md
msgid "[Find an F-Droid Consultant]({{ site.baseurl }}/consulting/)"
msgstr "[איתור ייעוץ ל־F-Droid]({{ site.baseurl }}/consulting/)"

